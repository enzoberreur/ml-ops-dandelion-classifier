# MLOps Dandelion Classifier - environment template.
# Copy to .env and adjust as needed: `cp .env.example .env`
# All values below are the defaults baked into docker-compose.yml; override only
# what you need. The .env file itself is gitignored.

# --- MinIO (S3-compatible object store) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Host port for the MinIO S3 API. Change if 9000 is already taken on your machine.
MINIO_API_PORT=9000
# Endpoint used by the app/airflow containers to reach MinIO (internal network).
MINIO_ENDPOINT=http://minio:9000
MINIO_SECURE=false
MINIO_DATA_BUCKET=dandelion-data
MINIO_MODEL_BUCKET=dandelion-models
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# --- Airflow ---
# Leave FERNET_KEY empty to let Airflow generate one, or set your own.
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=supersecretkey
